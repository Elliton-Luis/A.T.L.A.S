# ==========================================
# ATLAS — Configurações do Ambiente
# ==========================================

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# Token secreto configurado no webhook (para validação de segurança)
TELEGRAM_SECRET_TOKEN=
# Chat ID do Telegram exclusivo do proprietário (para whitelist de segurança)
TELEGRAM_CHAT_ID=

# IA e Processamento Cognitivo (NVIDIA NIM)
# Suporta uma ou várias chaves separadas por vírgula para rotação e fallback automático:
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Transcrição de Áudio / Voz (Groq Whisper) e NLU Rápido
# Suporta uma ou várias chaves separadas por vírgula para rotação e fallback automático:
GROQ_API_KEY=

# Banco de Dados (SQLite local ou Turso na Nuvem)
DB_PATH=data/atlas.sqlite
# Se preenchido, o ATLAS conecta no Turso Cloud (libSQL) em vez do arquivo local:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Token de segurança opcional para o endpoint de cron (/api/cron/tick)
CRON_SECRET=atlas_cron_secret_token

# Servidor e Fuso Horário
HTTP_PORT=8080
TIMEZONE=America/Sao_Paulo

# URL Pública do seu servidor (ex: seu Cloudflare Tunnel ou IP https://meubot.com)
PUBLIC_URL=http://localhost:8080

# Token pessoal e secreto para o link de assinatura de calendário (.ics)
CALENDAR_TOKEN=atlas_token_secreto_pessoal

# Horário do backup diário do banco enviado via Telegram (HH:MM)
BACKUP_HOUR=03:00

# ==========================================
# Controle Simplificado de Economia de Tokens
# ==========================================
MAX_TOKENS_QUICK=450
MAX_TOKENS_HEAVY=2048
MAX_TOKENS_RESEARCH=4096
CHAT_HISTORY_LIMIT=4

# ==========================================
# SONAR BRIDGE (Ponte de Terminal Linux & Agentes)
# ==========================================
# URL remota da bridge se o Sonar estiver exposto via túnel ou HTTP (opcional):
SONAR_BRIDGE_URL=
# Token de segurança da bridge (padrão do Sonar):
SONAR_BRIDGE_TOKEN=Li3cht3nst3in2
# Caminho do script de bridge local (quando o ATLAS roda na mesma máquina):
SONAR_CLI_PATH=/home/chocotonilitz/Programacao/projetos/sonar/sonar_bridge.php
# Diretório base permitido para comandos (Jail de segurança):
PROJECTS_BASE_DIR=/home/chocotonilitz/Programacao/projetos

# ==========================================
# LEITOR DE E-MAIL (Somente Leitura IMAP)
# ==========================================
# Host do provedor (ex: imap.gmail.com, outlook.office365.com)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=seu_email@gmail.com
# Senha de App (16 letras gerada nas configurações de segurança do Google ou provedor)
IMAP_PASS=sua_senha_de_app_aqui
